{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://teaching-skills.dev/schemas/kb.registry.schema.json",
  "title": "KnowledgeBaseRegistry",
  "description": "Schema for Teaching Skills Framework shared IMA Knowledge Base Registry",
  "type": "object",
  "required": ["version", "knowledge_bases"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "updated": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "maintainer": {
      "type": "string"
    },
    "knowledge_bases": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "textbook_count": {
            "type": ["integer", "null"]
          },
          "publishers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "default_local_dir_env": {
            "type": ["string", "null"]
          },
          "kb_id_env": {
            "type": ["string", "null"]
          }
        }
      }
    },
    "connectors": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": { "type": "string" },
          "description": { "type": "string" },
          "path_env": { "type": "string" },
          "endpoint_env": { "type": "string" },
          "api_key_env": { "type": "string" },
          "dataset_id_env": { "type": "string" }
        }
      }
    },
    "resolution_rules": {
      "type": "object",
      "properties": {
        "priority_order": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
